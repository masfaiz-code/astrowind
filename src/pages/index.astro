---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'DevFolio — Portofolio Developer & Software Engineer',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Lihat proyek',
        href: '#projects',
        icon: 'tabler:code',
      },
      { text: 'Hubungi saya', href: '/contact' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Developer working on code' }}
  >
    <Fragment slot="title">
      Portofolio <span class="hidden xl:inline">pengembang</span>
      <span class="text-accent dark:text-white"> Web & Software</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Saya seorang developer yang fokus membangun antarmuka web modern, API yang dapat di-scale, dan pengalaman
        digital yang rapi untuk pengguna.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Coding. Ship. Repeat.</span>
      Website ini menampilkan proyek, tech stack, dan cara saya berpikir sebagai engineer.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note
    title="Filosofi kerja:"
    description="Kode yang bersih, komunikasi yang jelas, dan produk yang benar-benar bermanfaat untuk pengguna."
  />

  <!-- Features Widget *************** -->
  <!-- Dipakai sebagai highlight skill / keunggulan utama -->

  <Features
    id="features"
    tagline="Keahlian"
    title="Fokus utama di dunia teknologi dan coding"
    subtitle="Menggabungkan pemahaman produk dengan engineering yang rapi, sehingga solusi yang dibuat tidak hanya jalan, tapi juga enak dipakai dan mudah dikembangkan."
    items={[
      {
        title: 'Frontend modern',
        description:
          'Pengalaman membangun UI responsif dengan framework modern (misalnya Astro, React) dan Tailwind CSS untuk styling yang konsisten.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Backend & API',
        description:
          'Mendesain dan mengembangkan RESTful API yang terstruktur, mudah diintegrasikan, dan memiliki dokumentasi yang jelas.',
        icon: 'tabler:server-2',
      },
      {
        title: 'Arsitektur yang bersih',
        description:
          'Mengutamakan struktur kode yang modular, dapat diuji, dan mudah dipahami oleh engineer lain dalam tim.',
        icon: 'tabler:layout-grid',
      },
      {
        title: 'Performance & kualitas',
        description:
          'Memperhatikan performa, aksesibilitas, dan best practice sehingga aplikasi tetap ringan dan nyaman digunakan.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Collaboration mindset',
        description:
          'Terbiasa kolaborasi dengan designer, PM, dan engineer lain; terbuka dengan feedback dan iterasi cepat.',
        icon: 'tabler:users',
      },
      {
        title: 'Belajar terus',
        description:
          'Aktif mengikuti perkembangan teknologi frontend, backend, dan tooling untuk meningkatkan kualitas solusi.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Content Widget **************** -->
  <!-- Dipakai sebagai section "Tentang Saya" -->

  <Content
    isReversed
    tagline="Tentang saya"
    title="Menggabungkan rasa ingin tahu, disiplin, dan perhatian pada detail"
    items={[
      {
        title: 'Berangkat dari rasa penasaran',
        description:
          'Saya menyukai proses memahami masalah bisnis, memetakan kebutuhan pengguna, lalu menerjemahkannya menjadi solusi teknis yang konkret.',
      },
      {
        title: 'Fokus pada maintainability',
        description:
          'Bagi saya, kode yang baik bukan hanya yang berjalan, tetapi yang bisa dipelihara dan dikembangkan oleh orang lain dengan mudah.',
      },
      {
        title: 'Nyaman di dunia produk digital',
        description:
          'Mulai dari landing page, dashboard internal, hingga integrasi ke service pihak ketiga; saya menikmati keseluruhan siklus pengembangan.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Developer team collaborating',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Dari baris kode ke solusi nyata
      </h3>
      Saya percaya bahwa engineer yang baik bukan hanya menulis kode, tetapi juga membantu tim mengambil keputusan
      teknis yang tepat.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <!-- Dipakai sebagai section "Cara kerja" -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Mulai dari masalah',
        description:
          'Selalu mengawali dengan memahami konteks: siapa penggunanya, apa yang ingin dicapai, dan batasan teknis yang ada.',
      },
      {
        title: 'Iterasi kecil dan cepat',
        description:
          'Membagi pekerjaan ke dalam bagian-bagian kecil yang bisa di-deliver secara berkala, sehingga feedback bisa didapat lebih cepat.',
      },
      {
        title: 'Testing seperlunya',
        description:
          'Menggunakan kombinasi testing manual dan otomatis (unit/integration) di area yang kritikal agar perilaku aplikasi tetap terjaga.',
      },
      {
        title: 'Dokumentasi seperlunya',
        description:
          'Menulis dokumentasi ringkas: README, catatan arsitektur singkat, dan contoh request untuk API; cukup untuk membantu orang lain melanjutkan.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Planning and wireframing',
    }}
  >
    <Fragment slot="content">Pendekatan yang pragmatis, bukan sekadar idealis.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->
  <!-- Dipakai sebagai section "Projects" utama -->

  <Content
    id="projects"
    isReversed
    isAfterContent
    items={[
      {
        title: 'Dashboard Analytics',
        description:
          'Single-page dashboard untuk memantau metrik bisnis dengan chart interaktif dan filter dinamis. Dibangun dengan framework frontend modern dan API terpisah.',
      },
      {
        title: 'Landing Page Produk SaaS',
        description:
          'Halaman marketing yang fokus pada konversi, dengan section pricing, testimoni, dan integrasi form ke tools marketing.',
      },
      {
        title: 'Internal Tools untuk Tim',
        description:
          'Aplikasi internal untuk membantu tim operasional melakukan input data, export laporan, dan automasi pekerjaan repetitif.',
      },
      {
        title: 'Eksperimen & side project',
        description:
          'Beberapa proyek kecil untuk mengeksplorasi teknologi baru, pattern arsitektur, dan ide produk yang belum tentu masuk produksi.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611465194529-1d44c88d2e72?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Showcase of projects',
    }}
  >
    <Fragment slot="content">Beberapa contoh tipe proyek yang biasa saya kerjakan.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <!-- Diadaptasi sebagai "Proses kerja proyek" -->

  <Steps
    title="Alur kerja saat mengerjakan sebuah proyek"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Explorasi & scope</span>',
        description:
          'Diskusi untuk memahami kebutuhan, ruang lingkup, dan prioritas. Menyepakati apa yang penting di versi pertama.',
        icon: 'tabler:package',
      },
      {
        title: 'Step 2: <span class="font-medium">Desain solusi</span>',
        description:
          'Menentukan struktur halaman, arsitektur aplikasi, dan antarmuka API. Jika perlu, membuat simple diagram dan wireframe.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'Step 3: <span class="font-medium">Implementasi & review</span>',
        description:
          'Membangun fitur secara iteratif, melakukan code review, dan memastikan kualitas sebelum di-deploy.',
        icon: 'tabler:paint',
      },
      {
        title: 'Step 4: <span class="font-medium">Launch & iterasi</span>',
        description:
          'Meluncurkan versi awal, memantau, lalu mengulangi proses berdasarkan data dan feedback pengguna.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->
  <!-- Diadaptasi sebagai "Tech Stack" -->

  <Features2
    title="Tech stack yang sering digunakan"
    subtitle="Kombinasi teknologi yang biasa saya pakai untuk membangun produk digital end-to-end."
    tagline="Tech Stack"
    items={[
      {
        title: 'Frontend',
        description: 'Astro, React, Tailwind CSS, dan komponen UI yang bisa digunakan kembali.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Backend',
        description: 'REST API dengan Node.js / TypeScript atau stack modern lain sesuai kebutuhan proyek.',
        icon: 'flat-color-icons:services',
      },
      {
        title: 'Database & data',
        description: 'Relasional maupun NoSQL, dipilih sesuai karakteristik data dan kebutuhan query.',
        icon: 'flat-color-icons:database',
      },
      {
        title: 'Testing & kualitas',
        description: 'Linting, formatting otomatis, dan testing di area yang kritikal untuk menjaga stabilitas.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Deploy & DevOps',
        description: 'Deploy ke platform modern (misalnya Vercel, Netlify, atau Docker-based) dengan workflow sederhana.',
        icon: 'flat-color-icons:deployment',
      },
      {
        title: 'Kolaborasi',
        description: 'Git, PR review, dan dokumentasi singkat agar kolaborasi dengan tim tetap efisien.',
        icon: 'flat-color-icons:collaboration',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- FAQs Widget ******************* -->
  <!-- Diadaptasi sebagai "Pertanyaan umum" terkait kerja sama -->

  <FAQs
    title="Pertanyaan umum"
    subtitle="Beberapa hal yang sering ditanyakan ketika mulai bekerja sama dalam sebuah proyek."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Apakah semua proyek harus dibuat dari nol?',
        description:
          'Tidak. Jika ada template, komponen, atau service yang sudah cocok, saya lebih memilih untuk memanfaatkannya agar lebih cepat rilis.',
      },
      {
        title: 'Bagaimana cara berkomunikasi selama proyek berjalan?',
        description:
          'Biasanya menggunakan kombinasi task tracker (Jira, Trello, atau sejenisnya) dan chat (Slack/Discord). Formatnya menyesuaikan kebiasaan tim.',
      },
      {
        title: 'Apakah bisa membantu review arsitektur atau kode yang sudah ada?',
        description:
          'Bisa. Saya dapat membantu melakukan review, memberi rekomendasi perbaikan, atau membuat plan refactor bertahap.',
      },
      {
        title: 'Apakah selalu mengikuti best practice terbaru?',
        description:
          'Saya mengikuti best practice sejauh relevan dan realistis untuk konteks proyek. Prioritas utama tetap value untuk user.',
      },
      {
        title: 'Apakah terbuka untuk remote collaboration?',
        description:
          'Ya. Terbiasa bekerja remote dengan perbedaan zona waktu dan kolaborasi asynchronous.',
      },
      {
        title: 'Bisakah mengerjakan proyek kecil / side project?',
        description:
          'Bisa. Proyek kecil justru sering jadi tempat yang bagus untuk bereksperimen dengan ide atau teknologi baru.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->
  <!-- Dibiarkan sebagai placeholder "angkanya" bisa disesuaikan -->

  <Stats
    stats={[
      { title: 'Project selesai', amount: '20+' },
      { title: 'Tech yang pernah dipakai', amount: '15+' },
      { title: 'Tahun pengalaman', amount: '3+' },
      { title: 'Side project aktif', amount: '4' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Diskusikan proyek',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Siap membahas <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">proyek berikutnya?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Jika kamu punya ide produk, butuh bantuan membangun MVP, atau ingin meng-upgrade aplikasi yang sudah ada, mari
      ngobrol dan cari pendekatan yang paling masuk akal.
    </Fragment>
  </CallToAction>
</Layout>
